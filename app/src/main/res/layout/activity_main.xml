<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="SEASON" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acSeason"
                        style="@style/FieldSpinner"
                        android:completionThreshold="1"
                        android:hint="Season..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="STYLE" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acStyleNo"
                        style="@style/FieldSpinner"
                        android:completionThreshold="1"
                        android:hint="Style..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="CURRENT STAGE" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acStage"
                        style="@style/FieldSpinner"
                        android:completionThreshold="1"
                        android:hint="Stage..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="MODEL" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acModel"
                        style="@style/FieldSpinner"
                        android:completionThreshold="1"
                        android:hint="Model..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/textView2"
                        style="@style/FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TEAM" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acTeam"
                        style="@style/FieldSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:hint="Team..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/textView5"
                        style="@style/FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DEV" />

                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/acDev"
                        style="@style/FieldSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:hint="Dev..."
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnRetrieve"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="LOAD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_red"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnClearFilter"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_bg"
                    android:text="CLEAR"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sẵn sàng."
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <!-- Nút Chọn tất cả (Slide 2 - Revision 0723) -->
        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Chọn tất cả"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/edit_bg"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- Nút Xóa kế hoạch (Slide 2 - Revision 0723) -->
        <Button
            android:id="@+id/btnDeletePlan"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Xóa kế hoạch"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_red"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="8dp" />

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/edit_bg"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp">

            <Spinner
                android:id="@+id/spinnerPlanFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/textSecondary"
                android:spinnerMode="dropdown"
                android:padding="0dp" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_no_data"
            android:contentDescription="No Data"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không có dữ liệu."
            android:textColor="@color/textSecondary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:shimmer_auto_start="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include layout="@layout/item_cfm_card_placeholder" />
            <include layout="@layout/item_cfm_card_placeholder" />
            <include layout="@layout/item_cfm_card_placeholder" />

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>

