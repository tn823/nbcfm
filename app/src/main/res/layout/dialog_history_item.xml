<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="8dp"
    android:background="@drawable/highlight_bg"
    android:elevation="1dp">

    <!-- Icon Lịch Sử -->

    <!-- Thời gian: Chia Ngày và Giờ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="11/07/2026" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="10:21:27" />
    </LinearLayout>

    <!-- Số lượng nhập -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SL: "
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etQty"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:inputType="number"
            android:background="@drawable/edit_bg"
            android:gravity="center"
            android:padding="6dp"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbHistoryMakeup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bù"
        android:textSize="12sp"
        android:textColor="@color/nb_red"
        android:visibility="gone" />

    <!-- Nút Xóa -->
    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="@color/nb_red"
        android:contentDescription="Xóa dòng" />

</LinearLayout>
