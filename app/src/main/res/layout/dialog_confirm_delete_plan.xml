<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="16dp">

    <!-- Header Popup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDialogIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⚠️"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xác nhận xóa kế hoạch"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Danh sách CFM được chọn để xóa:"
                android:textColor="#616161"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scroll container để chống tràn màn hình -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="260dp"
        android:scrollbars="vertical"
        android:fillViewport="true"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutCfmContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Thẻ câu hỏi / Cảnh báo phụ -->
    <TextView
        android:id="@+id/tvDialogQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn muốn thực hiện thao tác xóa như thế nào?"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:textColor="#616161"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/edit_bg"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDeletePlanOnly"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.3"
            android:text="CHỈ XÓA KH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_blue"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDeletePlanAndProd"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.4"
            android:text="XÓA KH + SX"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_red" />
    </LinearLayout>

</LinearLayout>
